{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DeustoTech/ECEAAS-website/docs/publications.schema.json",
  "title": "ECEAAS publications (CSL-JSON + custom)",
  "description": "Array of CSL-JSON items (https://citeproc-js.readthedocs.io/en/latest/csl-json/markup.html) with ECEAAS metadata in the standard `custom` object.",
  "type": "array",
  "items": { "$ref": "#/definitions/item" },
  "definitions": {
    "name": {
      "type": "object",
      "anyOf": [
        { "required": ["family", "given"] },
        { "required": ["literal"] }
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "given": { "type": "string", "minLength": 1 },
        "literal": { "type": "string", "minLength": 1, "description": "Use for institutional authors, e.g. \"ECEAAS Consortium\"." }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "title", "issued"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "description": "Unique key, e.g. casino2026cognitive." },
        "type": {
          "enum": ["article-journal", "paper-conference", "chapter", "book", "thesis", "report", "dataset", "software", "webpage", "article", "speech", "poster"]
        },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "array", "items": { "$ref": "#/definitions/name" } },
        "editor": { "type": "array", "items": { "$ref": "#/definitions/name" } },
        "issued": {
          "type": "object",
          "properties": {
            "date-parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": { "type": "integer" },
                "description": "[year, month?, day?]"
              }
            },
            "literal": { "type": "string" }
          }
        },
        "container-title": { "type": "string", "description": "Journal, proceedings or book title." },
        "container-title-short": { "type": "string" },
        "collection-title": { "type": "string" },
        "volume": { "type": ["string", "number"] },
        "issue": { "type": ["string", "number"] },
        "page": { "type": "string", "description": "First-last, e.g. 101-118." },
        "number-of-pages": { "type": ["string", "number"] },
        "publisher": { "type": "string" },
        "publisher-place": { "type": "string" },
        "event-title": { "type": "string" },
        "event-place": { "type": "string" },
        "genre": { "type": "string" },
        "DOI": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$", "description": "Bare DOI, without https://doi.org/." },
        "ISBN": { "type": "string" },
        "ISSN": { "type": "string", "pattern": "^\\d{4}-\\d{3}[\\dX]$" },
        "URL": { "type": "string", "format": "uri" },
        "abstract": { "type": "string" },
        "keyword": { "type": "string", "description": "Comma-separated keywords." },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "note": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "accessed": { "type": "object" },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subproject": {
              "type": "array",
              "items": { "enum": ["COG", "ISAC", "DATA"] },
              "uniqueItems": true
            },
            "wp": {
              "type": "array",
              "items": { "enum": ["WP1", "WP2", "WP3", "WP4", "WP5", "WP6", "WP7"] },
              "uniqueItems": true
            },
            "pdf": {
              "type": "string",
              "description": "\"publications/<file>.pdf\" (inside public/) or an https URL."
            },
            "openAccess": { "type": "boolean" },
            "featured": { "type": "boolean" },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "url"],
                "properties": { "label": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
              }
            }
          }
        }
      }
    }
  }
}
