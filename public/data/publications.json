  {
    "id": "urrutia-onate2026deployer-xai",
    "type": "article-journal",
    "title": "Deployer-Side XAI Instrumentation for Regulated AI: A Clinical Case Study in ICL Sizing",
    "author": [
      {
        "family": "Urrutia-Onate",
        "given": "Dorleta"
      },
      {
        "family": "Onieva",
        "given": "Enrique"
      },
